{
  "name": "together-live-poll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "dev:cloudflare": "wrangler dev --port 8787",
    "build:cloudflare": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "test:node": "node --test tests/integration.test.js",
    "test:cloudflare": "node --test tests/cloudflare.test.js"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
