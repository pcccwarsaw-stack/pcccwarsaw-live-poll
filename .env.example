HOST_SECRET=replace-with-at-least-24-random-characters
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
DB_PATH=./data/poll.sqlite
# Set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
# Optional: local Node server calls the real Cloudflare Workers AI REST API.
# Never commit these credentials. Workers deployment uses the AI binding instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
